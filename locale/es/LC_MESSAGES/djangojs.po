msgstr "Ya está en la cuadrícula"

#: comics/static/js/custom/connecting_editor.js:321
msgid "Choose a publishing…"
msgstr "Elige un publishing…"

#: comics/static/js/custom/connecting_editor.js:334
msgid "Choose a publishing to see its comics."
msgstr "Elige un publishing para ver sus comics."

#: comics/static/js/custom/connecting_editor.js:337
#: comics/static/js/custom/issue_picker.js:94
msgid "Loading…"
msgstr "Cargando…"

#: comics/static/js/custom/connecting_editor.js:347
msgid "Drag a cover onto the grid, or click it and then a cell."
msgstr ""
"Arrastra una portada a la cuadrícula o haz clic en ella y luego en una celda."

#: comics/static/js/custom/connecting_editor.js:348
msgid "This publishing has no comics."
msgstr "Este publishing no tiene comics."

#: comics/static/js/custom/connecting_editor.js:351
msgid "The comics could not be loaded. Try again."
msgstr "No se pudieron cargar los comics. Intenta de nuevo."

#: comics/static/js/custom/connecting_editor.js:387
msgid ""
"There are pieces outside the grid. Place them in a cell or remove them "
"before saving."
msgstr ""
"Hay piezas fuera de la cuadrícula. Colócalas en una celda o quítalas antes "
"de guardar."

#: comics/static/js/custom/connecting_editor.js:404
msgid "Saving…"
msgstr "Guardando…"

#: comics/static/js/custom/connecting_editor.js:413
msgid ""
"Your session expired or you do not have permission. Reload the page and log "
"in."
msgstr ""
"Tu sesión expiró o no tienes permisos. Recarga la página e inicia sesión."

#: comics/static/js/custom/connecting_editor.js:419
msgid "Could not save."
msgstr "No se pudo guardar."

#: comics/static/js/custom/connecting_editor.js:430
msgid "Connecting saved"
msgstr "Connecting guardado"

#: comics/static/js/custom/connecting_editor.js:432
msgid "Could not connect to the server."
msgstr "No se pudo conectar con el servidor."

#: comics/static/js/custom/edition_form.js:52
